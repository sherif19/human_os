rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return isSignedIn() && (
        getUserData().role == 'admin' || 
        getUserData().role == 'super_admin'
      );
    }
    function isSuperAdmin() {
      return isSignedIn() && getUserData().role == 'super_admin';
    }

    // User Profile
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();

      // DNA Profiles
      match /dna/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Journeys
      match /journeys/{journeyId} {
        allow read, write: if isOwner(userId);
      }

      // Projects
      match /projects/{projectId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Tenants
    match /tenants/{tenantId} {
      allow read: if true;
      allow write: if isOwner(tenantId) || isSuperAdmin();
    }

    // Payments
    match /payments/{paymentId} {
      allow read: if isSignedIn() && (
        resource == null || 
        resource.data.userId == request.auth.uid || 
        resource.data.adminId == request.auth.uid || 
        isAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // Sales
    match /sales/{saleId} {
      allow read, write: if isAdmin();
    }

    // Brand Library (Books & Templates)
    match /brandLibrary/{docId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || (isSignedIn() && getUserData().role == 'employee');
    }

    // Appointments
    match /appointments/{appointmentId} {
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.userId == request.auth.uid ||
        resource.data.adminId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && 
        request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.adminId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }
  }
}
